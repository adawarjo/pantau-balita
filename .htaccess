# Pantau Balita - pengaturan Apache
Options -Indexes
DirectoryIndex index.php

# Lindungi file sensitif di root (dump database, dokumentasi, file tersembunyi)
<FilesMatch "(\.(sql|md|log|ini|sh|bak)|^\..*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# PWA: tipe MIME manifest & service worker selalu diperiksa ulang
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Service-Worker-Allowed "/"
    </Files>
    <Files "manifest.webmanifest">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

